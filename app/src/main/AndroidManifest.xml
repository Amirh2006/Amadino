<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amadino">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Amadino">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.sms.SmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.amadino.app.action.SMS_SENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.sms.SmsDeliveredReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.amadino.app.action.SMS_DELIVERED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
