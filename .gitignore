# Amadino — Android / Kotlin / Gradle .gitignore

# Built application files
*.apk
*.aab
*.apks

# Gradle
.gradle/
build/
*.iml

# Local configuration file (signed/keystore paths, signing configs)
local.properties

# Android Studio / IntelliJ
.idea/
*.ipr
*.iws
*.ipr
out/

# Keystore files
*.jks
*.keystore
*.key
*.pk8
*.pem

# OS generated files
.DS_Store
Thumbs.db

# Kotlin
*.kotlin.metadata

# Logs
*.log

# Generated source / bindings (regenerated by build)
**/generated/

# ProGuard / R8 output (generated)
proguard/

# Secrets / environment
.env
*.env
secrets.properties
keystore.properties